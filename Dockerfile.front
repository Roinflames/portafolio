FROM nginx:1.27-alpine

WORKDIR /usr/share/nginx/html

COPY nginx.front.conf /etc/nginx/conf.d/default.conf
COPY index.html ./index.html
COPY styles.css ./styles.css
COPY app.js ./app.js
COPY ai-subscriptions.json ./ai-subscriptions.json
COPY community-ops.json ./community-ops.json
COPY notes.json ./notes.json
COPY plantiwuis-kpis.json ./plantiwuis-kpis.json
COPY plantiwuis.json ./plantiwuis.json
COPY portfolio-metrics.json ./portfolio-metrics.json
COPY sales-metrics.json ./sales-metrics.json
COPY sales-periods.json ./sales-periods.json

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
